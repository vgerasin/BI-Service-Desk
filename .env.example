# Copy to .env and fill in. Everything else (SSO, SMTP, Telegram, HR directory, refresh monitoring)
# is configured in the web UI: Управление → Система → Настройки.

# --- required ---
DB_PASSWORD=change-me
# Signs login tokens and derives the key that encrypts integration secrets stored in the DB.
# Generate:  openssl rand -hex 32   (changing it later makes saved secrets unreadable)
JWT_SECRET=

# --- first start ---
# Account created on an empty database; also always promoted to admin (handy with SSO).
ADMIN_EMAIL=admin@example.com
# If empty, a random password is generated and printed once in the app log.
ADMIN_PASSWORD=

# --- optional ---
APP_NAME=BI Service Desk
# Public address of the app (used in e-mail links and the SSO redirect URI).
APP_URL=http://localhost:3000
APP_PORT=3000

# Demo data: set to any string, call POST /api/admin/seed once with header x-seed-secret, then remove.
# SEED_SECRET=
